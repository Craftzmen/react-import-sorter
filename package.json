{
  "name": "react-import-sorter",
  "version": "1.2.0",
  "description": "Opinionated import sorter for React apps",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./prettier-plugin": {
      "types": "./dist/src/prettierPluginCjs.d.ts",
      "require": "./dist/src/prettierPluginCjs.js",
      "default": "./dist/src/prettierPluginCjs.js"
    },
    "./eslint-plugin": {
      "types": "./dist/src/eslintPlugin.d.ts",
      "require": "./dist/src/eslintPlugin.js",
      "default": "./dist/src/eslintPlugin.js"
    }
  },
  "bin": {
    "react-import-sorter": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "dev": "ts-node bin/cli.ts",
    "vscode:install": "npm --prefix vscode-extension install",
    "vscode:build": "npm --prefix vscode-extension run build",
    "vscode:watch": "npm --prefix vscode-extension run watch",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "release:check": "npm run build && npm test && npm pack --dry-run",
    "release:pack": "npm pack"
  },
  "keywords": [
    "react",
    "imports",
    "sort",
    "cli"
  ],
  "author": "Craftzmen",
  "license": "MIT",
  "type": "commonjs",
  "peerDependencies": {
    "eslint": ">=8.0.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "recast": "^0.23.11"
  },
  "devDependencies": {
    "@types/eslint": "^8.56.0",
    "@types/node": "^25.5.0",
    "eslint": "^8.56.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
